#!/bin/bash
# 切换到脚本所在目录，并进入 Sources/github_raw
cd "$(dirname "$0")/Sources/github_raw" || exit 1

echo "========================================="
echo "正在检查并从 GitHub 同步 Spacemit 官方文档..."
echo "========================================="

# 执行 git pull 同步上游
git pull

echo "========================================="
echo "同步完成！本窗口将在 5 秒后自动关闭..."
echo "========================================="
sleep 5
