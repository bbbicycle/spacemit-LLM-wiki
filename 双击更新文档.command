#!/usr/bin/env bash
# ==============================================================================
# Spacemit LLM Wiki - macOS 双击更新文档脚本
# ==============================================================================

# 切换到脚本所在根目录
cd "$(dirname "$0")" || exit 1

echo "========================================="
echo "  Spacemit LLM Wiki 一键同步程序启动  "
echo "========================================="
echo ""

# 调用 update_sources.sh 执行子模块同步
if ./update_sources.sh; then
    echo ""
    echo "========================================="
    echo "  🎉 文档与配图同步成功完成！"
    echo "  本窗口将在 5 秒后自动关闭..."
    echo "========================================="
else
    echo ""
    echo "========================================="
    echo "  ❌ [错误] 同步过程中发生异常！"
    echo "  请检查网络连接或 Git 配置。"
    echo "  本窗口将在 5 秒后自动关闭..."
    echo "========================================="
fi

sleep 5
