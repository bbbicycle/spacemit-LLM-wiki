{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spacemit-wiki-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "routes": [
    {
      "pattern": "mcp.yao1302.xyz",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "spacemit-wiki-db",
      "database_id": "f37a731d-be82-452b-b740-3b068b6f1973"
    }
  ],
  "observability": {
    "enabled": true
  }
}
